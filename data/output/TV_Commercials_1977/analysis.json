    {
      "id": "speech-00003",
      "start_sec": 26.26,
      "end_sec": 29.26,
      "text": "Oscar Meyer, the first name in balona."
    },
    {
      "id": "speech-00004",
      "start_sec": 29.26,
      "end_sec": 35.56,
      "text": "What's behind the brand of hot dogs you buy?"
    },
    {
      "id": "speech-00005",
      "start_sec": 35.56,
      "end_sec": 41.56,
      "text": "You know you're getting solid value with Oscar Meyer and quality trusted for generations."
    },
    {
      "id": "speech-00006",
      "start_sec": 41.56,
      "end_sec": 45.56,
      "text": "There's holds of meat protein from solid cuts of meat."
    },
    {
      "id": "speech-00007",
      "start_sec": 45.56,
      "end_sec": 47.56,
      "text": "They only meet Oscar Meyer uses."
    },
    {
      "id": "speech-00008",
      "start_sec": 47.56,
      "end_sec": 49.56,
      "text": "U.S. government-inspective."
    },
    {
      "id": "speech-00009",
      "start_sec": 49.56,
      "end_sec": 51.56,
      "text": "Oscar Meyer selected."
    },
    {
      "id": "speech-00010",
      "start_sec": 51.56,
      "end_sec": 54.56,
      "text": "Oscar Meyer winners in beef ranks in handy twin bags."
    },
    {
      "id": "speech-00011",
      "start_sec": 54.56,
      "end_sec": 57.56,
      "text": "The flavors as good as the good meat itself."
    },
    {
      "id": "speech-00012",
      "start_sec": 57.56,
      "end_sec": 59.56,
      "text": "Oscar Meyer, America."
